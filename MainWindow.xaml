<Window x:Class="DocToPdfTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocToPdfTool - 文档转换工具"
        Width="800"
        Height="500"
        MinWidth="680"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 左侧导航（默认隐藏，从首页点击功能后显示） -->
        <Border x:Name="SideNav" DockPanel.Dock="Left" Width="180" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,14,12,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="BtnBackHome" DockPanel.Dock="Right" Content="🏠 首页"
                                FontSize="12" Padding="8,4" Margin="8,0,0,0"
                                ToolTip="返回首页"
                                Click="BtnBackHome_Click"
                                Background="Transparent" BorderBrush="#E0E0E0"/>
                        <TextBlock Text="功能导航" Foreground="#888888" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ListBox Grid.Row="1" x:Name="NavList" Style="{StaticResource NavListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="DocToPdf" Content="文档转PDF" FontSize="14"/>
                    <ListBoxItem Tag="WordToPdf" Content="Word转PDF" FontSize="14"/>
                    <ListBoxItem Tag="ExcelToPdf" Content="Excel转PDF" FontSize="14"/>
                    <ListBoxItem Tag="ExcelToImage" Content="Excel转图片" FontSize="14"/>
                    <ListBoxItem Tag="PptToPdf" Content="PPT转PDF" FontSize="14"/>
                    <ListBoxItem Tag="PptToWord" Content="PPT转Word" FontSize="14"/>
                    <ListBoxItem Tag="PptToImage" Content="PPT转图片" FontSize="14"/>
                    <ListBoxItem Tag="WordToImage" Content="Word转图片" FontSize="14"/>
                    <ListBoxItem Tag="PdfToWord" Content="PDF转Word" FontSize="14"/>
                    <ListBoxItem Tag="PdfToImage" Content="PDF转图片" FontSize="14"/>
                    <ListBoxItem Tag="ImageToPdf" Content="图片转PDF" FontSize="14"/>
                    <ListBoxItem Tag="PdfEncrypt" Content="PDF加密" FontSize="14"/>
                    <ListBoxItem Tag="PdfWatermark" Content="PDF水印" FontSize="14"/>
                    <ListBoxItem Tag="PdfPageManager" Content="PDF页面管理" FontSize="14"/>
                    <ListBoxItem Tag="PdfImageExtract" Content="PDF提取图片" FontSize="14"/>
                    <ListBoxItem Tag="PdfCompress" Content="PDF压缩" FontSize="14"/>
                    <ListBoxItem Tag="PdfPageNumber" Content="PDF加页码" FontSize="14"/>
                    <ListBoxItem Tag="ExcelSplitMerge" Content="Excel拆分合并" FontSize="14"/>
                    <ListBoxItem Tag="ImageBatch" Content="图片批量处理" FontSize="14"/>
                    <ListBoxItem Tag="IdPhotoLayout" Content="证件照排版" FontSize="14"/>
                    <ListBoxItem Tag="TextExtract" Content="提取纯文本" FontSize="14"/>
                    <ListBoxItem Tag="PdfToExcel" Content="PDF转Excel" FontSize="14"/>
                    <ListBoxItem Tag="PdfToPpt" Content="PDF转PPT" FontSize="14"/>
                    <ListBoxItem Tag="PdfToScannedPdf" Content="PDF转扫描件" FontSize="14"/>
                    <ListBoxItem Tag="PdfSplit" Content="拆分PDF" FontSize="14"/>
                    <ListBoxItem Tag="PdfMerge" Content="合并PDF" FontSize="14"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右上角：设置 + 置顶按钮（默认隐藏，功能页显示） -->
        <StackPanel x:Name="TopBar" DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,12,0" Visibility="Collapsed">
            <Button x:Name="BtnSettings" Content="≡" FontSize="16"
                    Padding="8,0" Margin="0,0,8,0"
                    ToolTip="设置"
                    Click="BtnSettings_Click"
                    Background="Transparent" BorderBrush="Transparent"/>
            <ToggleButton x:Name="BtnTopmost" Content="📌 置顶"
                          Padding="8,2"
                          Click="BtnTopmost_Click" Style="{StaticResource TopmostToggleButton}"/>
        </StackPanel>

        <!-- 右侧内容区 -->
        <ContentControl x:Name="PageContent" Focusable="False" Margin="0,0,0,0"/>
    </DockPanel>
</Window>