<UserControl x:Class="DocToPdfTool.Pages.OcrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加文件" Padding="14,6" Click="BtnAddFiles_Click"/>
            <Button x:Name="BtnPaste" Content="粘贴识别" Padding="12,6" Margin="8,0,0,0" Click="BtnPaste_Click"
                    ToolTip="识别剪贴板中最新的图片（Ctrl+V 也可以）"/>
            <Button x:Name="BtnOpenModels" Content="模型目录" Padding="10,6" Margin="8,0,0,0"
                    FontSize="12" Click="BtnOpenModels_Click"
                    ToolTip="打开 OCR 模型缓存目录（%LOCALAPPDATA%\DocToPdfTool\models）"/>
            <TextBlock Text="或拖拽图片 / PDF 到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="10,0,0,0" MaxWidth="140"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 列表 / 结果 两个标签页 -->
        <TabControl Grid.Row="1" x:Name="ResultTabs" BorderBrush="#E0E0E0" Background="White">
            <TabItem Header="文件列表">
                <Grid>
                    <ListView x:Name="FileListView"
                              AllowDrop="True"
                              Drop="FileListView_Drop"
                              PreviewDragOver="FileListView_PreviewDragOver"
                              SizeChanged="FileListView_SizeChanged"
                              BorderThickness="0"
                              Foreground="#1A1A1A"
                              SelectionChanged="FileListView_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="文件名" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="类型" Width="62" DisplayMemberBinding="{Binding TypeText}"/>
                                <GridViewColumn Header="识别结果" Width="140" DisplayMemberBinding="{Binding ResultText}"/>
                                <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding StatusText}"/>
                                <GridViewColumn Header="操作" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="移除" Padding="6,2" FontSize="12"
                                                    MinWidth="46" HorizontalAlignment="Center"
                                                    Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border x:Name="EmptyOverlay" Background="White" IsHitTestVisible="False" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="拖拽图片或 PDF 到此处，或点击上方「添加文件」"
                                       Foreground="#BBBBBB" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="内置 PP-OCRv4 引擎，扫描件、截图、照片里的文字都能识别"
                                       Foreground="#CCCCCC" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="识别结果" x:Name="ResultTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,6,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtResultFile" Text="尚未识别"
                                   Foreground="#666666" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" x:Name="BtnCopy" Content="复制全部" Padding="10,3"
                                FontSize="12" Margin="0,0,6,0" Click="BtnCopy_Click"/>
                        <Button Grid.Column="2" x:Name="BtnSaveAs" Content="另存为" Padding="10,3"
                                FontSize="12" Click="BtnSaveAs_Click"/>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TxtResult" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="13" Padding="6" BorderBrush="#E0E0E0" Background="#FAFAFA"
                             VerticalContentAlignment="Top"
                             Text="识别完成后，结果会显示在这里，可直接全选复制。"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 设置区 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6" Height="96">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="页码范围:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtPageRange" Width="86" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center"
                             ToolTip="留空=全部，支持 1-5,8（仅 PDF 有效）"/>

                    <TextBlock Text="渲染 DPI:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="12,0,0,0"/>
                    <ComboBox x:Name="CmbDpi" SelectedIndex="1" Width="76" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="200"/>
                        <ComboBoxItem Content="300"/>
                        <ComboBoxItem Content="400"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkPageSeparator" Content="页之间加分隔" IsChecked="False"
                              FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,6,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="首次使用需下载约 15 MB 模型（之后离线可用）；手写体不支持"/>
            </StackPanel>
        </Border>

        <!-- 执行 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始识别" Padding="24,8" Width="150"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center" Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
