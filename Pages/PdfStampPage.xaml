<UserControl x:Class="DocToPdfTool.Pages.PdfStampPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock x:Name="TxtDropHint" Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="原大小" Width="90"
                                    DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="处理后" Width="90"
                                    DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="状态" Width="110"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,10,0,10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 章图片 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectSeal" Content="选择章图片..." Padding="14,5"
                            Click="BtnSelectSeal_Click"/>
                    <TextBlock x:Name="TxtSealName" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#999999" FontSize="12" Text="未选择（建议透明底 PNG）"/>
                </StackPanel>

                <!-- 位置九宫格 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="位置:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CbPosition" Width="100" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="8">
                        <ComboBoxItem Content="左上"/>
                        <ComboBoxItem Content="上中"/>
                        <ComboBoxItem Content="右上"/>
                        <ComboBoxItem Content="左中"/>
                        <ComboBoxItem Content="居中"/>
                        <ComboBoxItem Content="右中"/>
                        <ComboBoxItem Content="左下"/>
                        <ComboBoxItem Content="下中"/>
                        <ComboBoxItem Content="右下"/>
                    </ComboBox>
                    <TextBlock Text="大小:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBox x:Name="TxtWidthRatio" Width="46" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Text="18"/>
                    <TextBlock Text="% 页宽" VerticalAlignment="Center" Foreground="#AAAAAA"
                               FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 旋转 + 页码范围 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="旋转:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CbRotation" Width="70" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="0°"/>
                        <ComboBoxItem Content="15°"/>
                        <ComboBoxItem Content="30°"/>
                        <ComboBoxItem Content="45°"/>
                        <ComboBoxItem Content="90°"/>
                        <ComboBoxItem Content="180°"/>
                    </ComboBox>
                    <TextBlock Text="页码范围:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBox x:Name="TxtPageRange" Width="100" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Text="全部"/>
                    <TextBlock Text="（空/全部 = 所有页）" VerticalAlignment="Center"
                               Foreground="#AAAAAA" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="把章图片绘制到页面指定位置，支持九宫格、大小比例、旋转与页码范围"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始盖章"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
