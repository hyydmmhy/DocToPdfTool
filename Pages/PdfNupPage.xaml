<UserControl x:Class="DocToPdfTool.Pages.PdfNupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock x:Name="TxtDropHint" Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="原大小" Width="90"
                                    DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="处理后" Width="90"
                                    DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="状态" Width="110"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,10,0,10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 第一行：拼版数 + 纸张 + 方向 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="拼版:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CbN" Width="80" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="2">
                        <ComboBoxItem Content="2 合1"/>
                        <ComboBoxItem Content="4 合1"/>
                        <ComboBoxItem Content="6 合1"/>
                        <ComboBoxItem Content="9 合1"/>
                        <ComboBoxItem Content="16 合1"/>
                    </ComboBox>
                    <TextBlock Text="纸张:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CbPaper" Width="60" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="A4"/>
                        <ComboBoxItem Content="A3"/>
                    </ComboBox>
                    <TextBlock Text="方向:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CbOrientation" Width="60" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="纵向"/>
                        <ComboBoxItem Content="横向"/>
                    </ComboBox>
                </StackPanel>

                <!-- 第二行：边距 + 间隙 + 页码范围 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="边距:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtMargin" Width="46" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Text="10"/>
                    <TextBlock Text="mm" VerticalAlignment="Center" Foreground="#AAAAAA"
                               FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="间隙:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBox x:Name="TxtGap" Width="46" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Text="4"/>
                    <TextBlock Text="mm" VerticalAlignment="Center" Foreground="#AAAAAA"
                               FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="页码范围:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBox x:Name="TxtPageRange" Width="100" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Text="全部"/>
                </StackPanel>

                <!-- 第三行：裁切线 + 顺序 + DPI -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox x:Name="ChkCutLines" Content="绘制裁切线" VerticalAlignment="Center"
                              FontSize="12"/>
                    <TextBlock Text="顺序:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CbOrder" Width="110" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="从左到右"/>
                        <ComboBoxItem Content="从上到下"/>
                    </ComboBox>
                    <TextBlock Text="DPI:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CbDpi" Width="70" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="300"/>
                        <ComboBoxItem Content="600"/>
                    </ComboBox>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="把多个原页面按宫格缩放到一张纸，省纸打印 / 打印讲义；DPI 越高越清晰，文件越大"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始拼版"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
