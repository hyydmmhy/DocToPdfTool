<UserControl x:Class="DocToPdfTool.Pages.ImageStitchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加图片" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock Text="或拖拽图片到此处（按列表顺序拼接，可上移/下移调整）"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="尺寸" Width="90"
                                    DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="大小" Width="80"
                                    DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="操作" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="↑" Padding="6,2" FontSize="12"
                                            MinWidth="30" Tag="{Binding}" Click="BtnMoveUp_Click"/>
                                    <Button Content="↓" Padding="6,2" FontSize="12"
                                            MinWidth="30" Margin="4,0,0,0" Tag="{Binding}" Click="BtnMoveDown_Click"/>
                                    <Button Content="移除" Padding="6,2" FontSize="12"
                                            MinWidth="46" Margin="4,0,0,0" Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽图片到此处，或点击上方「添加图片」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 方向 / 宽度策略 / 自定义宽度 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="28">
                    <TextBlock Text="方向:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbDirection" SelectedIndex="0" Width="120" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="纵向（长图）"/>
                        <ComboBoxItem Content="横向"/>
                    </ComboBox>

                    <TextBlock Text="宽度:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="12,0,0,0"/>
                    <ComboBox x:Name="CmbWidthMode" SelectedIndex="0" Width="130" Margin="6,0,0,0"
                              VerticalAlignment="Center" SelectionChanged="WidthMode_Changed">
                        <ComboBoxItem Content="保持原始尺寸"/>
                        <ComboBoxItem Content="以最宽为基准"/>
                        <ComboBoxItem Content="以最窄为基准"/>
                        <ComboBoxItem Content="自定义宽度"/>
                    </ComboBox>
                    <TextBox x:Name="TxtCustomWidth" Width="70" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="1920" IsEnabled="False"/>
                </StackPanel>

                <!-- 间距 / 背景 / 输出格式 / JPG质量 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="28">
                    <TextBlock Text="间距:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtSpacing" Width="50" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="0"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                               Margin="4,0,0,0"/>

                    <CheckBox x:Name="ChkTransparent" Content="透明背景（仅PNG）" FontSize="12"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <TextBlock Text="输出:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CmbFormat" SelectedIndex="0" Width="70" Margin="6,0,0,0"
                              VerticalAlignment="Center" SelectionChanged="Format_Changed">
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="PNG"/>
                    </ComboBox>

                    <TextBlock x:Name="LblQuality" Text="JPG质量:" VerticalAlignment="Center"
                               Foreground="#888888" FontSize="12" Margin="12,0,0,0"/>
                    <TextBox x:Name="TxtQuality" Width="44" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="92"/>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="纵向拼接每张图统一到同一宽度（保持宽高比），间距可设；超出 2 亿像素自动整体缩小"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始拼接"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
