<UserControl x:Class="DocToPdfTool.Pages.PdfCompressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="160"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="原始大小" Width="68"
                                    DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="压缩后" Width="132"
                                    DisplayMemberBinding="{Binding NewText}"/>
                    <GridViewColumn Header="状态" Width="76"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区（固定高度、顶部对齐） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="124">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 档位 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="压缩档位:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <RadioButton x:Name="RdoLight" Content="轻度" IsChecked="True" Margin="10,0,0,0"
                                 GroupName="Level" VerticalAlignment="Center"
                                 Checked="Level_Changed" ToolTip="不重采样，仅高质量重编码，画质接近原样"/>
                    <RadioButton x:Name="RdoStandard" Content="标准" Margin="14,0,0,0"
                                 GroupName="Level" VerticalAlignment="Center"
                                 Checked="Level_Changed" ToolTip="重采样到 200 DPI + 质量 88，体积与画质平衡"/>
                    <RadioButton x:Name="RdoStrong" Content="强力" Margin="14,0,0,0"
                                 GroupName="Level" VerticalAlignment="Center"
                                 Checked="Level_Changed" ToolTip="重采样到 150 DPI + 质量 82"/>
                    <RadioButton x:Name="RdoExtreme" Content="极限" Margin="14,0,0,0"
                                 GroupName="Level" VerticalAlignment="Center"
                                 Checked="Level_Changed" ToolTip="重采样到 110 DPI + 质量 75，体积最小"/>
                    <RadioButton x:Name="RdoCustom" Content="自定义" Margin="14,0,0,0"
                                 GroupName="Level" VerticalAlignment="Center"
                                 Checked="Level_Changed"/>
                </StackPanel>

                <!-- 自定义参数 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                    <TextBlock Text="目标分辨率:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbDpi" SelectedIndex="0" Width="110" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="不重采样"/>
                        <ComboBoxItem Content="300 DPI"/>
                        <ComboBoxItem Content="240 DPI"/>
                        <ComboBoxItem Content="200 DPI"/>
                        <ComboBoxItem Content="150 DPI"/>
                        <ComboBoxItem Content="120 DPI"/>
                        <ComboBoxItem Content="96 DPI"/>
                        <ComboBoxItem Content="72 DPI"/>
                    </ComboBox>

                    <TextBlock Text="JPEG 质量:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBox x:Name="TxtQuality" Width="52" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="88"/>
                    <TextBlock Text="(50~98，越高越清晰)"
                               VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="轻度：不重采样，画质接近原样；文字层保留，压缩后仍可搜索复制"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始压缩"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
