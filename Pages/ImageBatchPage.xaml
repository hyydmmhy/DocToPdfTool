<UserControl x:Class="DocToPdfTool.Pages.ImageBatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加图片" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock Text="或拖拽图片到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="尺寸" Width="90"
                                    DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="原大小" Width="80"
                                    DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="处理后" Width="120"
                                    DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="状态" Width="80"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽图片到此处，或点击上方「添加图片」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区（固定高度、顶部对齐） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="124">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 格式 / 缩放 / 数值 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="格式:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbFormat" SelectedIndex="1" Width="104" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="保持原格式"/>
                        <ComboBoxItem Content="统一 JPG"/>
                        <ComboBoxItem Content="统一 PNG"/>
                        <ComboBoxItem Content="统一 BMP"/>
                    </ComboBox>

                    <TextBlock Text="缩放:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="10,0,0,0"/>
                    <ComboBox x:Name="CmbResize" SelectedIndex="0" Width="86" Margin="6,0,0,0"
                              VerticalAlignment="Center" SelectionChanged="Resize_Changed">
                        <ComboBoxItem Content="不缩放"/>
                        <ComboBoxItem Content="按宽度"/>
                        <ComboBoxItem Content="按高度"/>
                        <ComboBoxItem Content="按长边"/>
                        <ComboBoxItem Content="按百分比"/>
                    </ComboBox>

                    <TextBox x:Name="TxtResizeValue" Width="58" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="1920" IsEnabled="False"/>
                    <TextBlock x:Name="TxtResizeUnit" Text="px"
                               VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 质量 / 目标体积 / 方向 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                    <TextBlock Text="JPG 质量:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtQuality" Width="44" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="92"/>

                    <TextBlock Text="目标体积:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="12,0,0,0"/>
                    <TextBox x:Name="TxtTargetKb" Width="58" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="KB"
                               VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                               Margin="4,0,0,0"/>

                    <CheckBox x:Name="ChkAutoOrient" Content="自动纠正拍摄方向" IsChecked="True"
                              FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="不改尺寸、不改格式时直接复制原文件，零损失；目标体积留空表示不限制（仅对 JPG 生效）"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始处理"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
