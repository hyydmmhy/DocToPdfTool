<UserControl x:Class="DocToPdfTool.Pages.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnImport" Content="导入 TXT" Padding="12,5" Click="BtnImport_Click"/>
            <TextBlock Text="目标语言:" VerticalAlignment="Center" Foreground="#888888"
                       FontSize="12" Margin="12,0,0,0"/>
            <ComboBox x:Name="CmbTarget" SelectedIndex="1" Width="96" Margin="6,0,0,0"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                <ComboBoxItem Content="英语" Tag="en"/>
                <ComboBoxItem Content="日语" Tag="ja"/>
                <ComboBoxItem Content="韩语" Tag="ko"/>
                <ComboBoxItem Content="繁体中文" Tag="zh-Hant"/>
                <ComboBoxItem Content="法语" Tag="fr"/>
                <ComboBoxItem Content="德语" Tag="de"/>
                <ComboBoxItem Content="西班牙语" Tag="es"/>
                <ComboBoxItem Content="俄语" Tag="ru"/>
            </ComboBox>

            <TextBlock Text="引擎:" VerticalAlignment="Center" Foreground="#888888"
                       FontSize="12" Margin="12,0,0,0"/>
            <ComboBox x:Name="CmbEngine" SelectedIndex="0" Width="88" Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      ToolTip="首选引擎失败时会自动切换到另一个">
                <ComboBoxItem Content="微软翻译"/>
                <ComboBoxItem Content="腾讯翻译"/>
            </ComboBox>

            <Button x:Name="BtnTranslate" Content="开始翻译" Margin="12,0,0,0"
                    Padding="16,5" Click="BtnTranslate_Click"/>
        </StackPanel>

        <!-- 原文 -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="原文" Foreground="#666666" FontSize="12" Margin="2,0,0,4"/>
            <TextBox x:Name="TxtSource" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="13" Padding="6" BorderBrush="#E0E0E0"
                     VerticalContentAlignment="Top"/>
        </DockPanel>

        <!-- 分隔 -->
        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="译文" Foreground="#666666" FontSize="12"
                       VerticalAlignment="Center" Margin="2,0,0,0"/>
            <Button Grid.Column="1" x:Name="BtnCopy" Content="复制" Padding="10,3" FontSize="12"
                    Margin="0,0,6,0" Click="BtnCopy_Click"/>
            <Button Grid.Column="2" x:Name="BtnSave" Content="保存" Padding="10,3" FontSize="12"
                    Click="BtnSave_Click"/>
        </Grid>

        <!-- 译文 -->
        <TextBox Grid.Row="3" x:Name="TxtResult"
                 AcceptsReturn="True" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="6" BorderBrush="#E0E0E0"
                 Background="#FAFAFA"
                 VerticalContentAlignment="Top"/>

        <!-- 状态 -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   Margin="2,8,0,0" Text="粘贴文本或导入 TXT，选择目标语言后点「开始翻译」"/>
    </Grid>
</UserControl>
