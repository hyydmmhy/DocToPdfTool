<UserControl x:Class="DocToPdfTool.Pages.TextExtractPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock Text="或拖拽 PDF / Word / PPT / TXT / MD 到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="230"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="类型" Width="70"
                                    DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="提取结果" Width="150"
                                    DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="状态" Width="110"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="拖拽文件到此处，或点击上方「添加文件」按钮"
                           Foreground="#BBBBBB" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="支持 PDF / Word / PPT / TXT / MD，可一键合并成一个 txt 方便检索"
                           Foreground="#CCCCCC" FontSize="12" Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 设置区（固定高度、顶部对齐） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="124">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 编码 / 输出方式 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="编码:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbEncoding" SelectedIndex="1" Width="132" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="UTF-8"/>
                        <ComboBoxItem Content="UTF-8（带 BOM）"/>
                        <ComboBoxItem Content="GBK（兼容旧软件）"/>
                    </ComboBox>

                    <TextBlock Text="输出方式:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="14,0,0,0"/>
                    <ComboBox x:Name="CmbOutputMode" SelectedIndex="0" Width="168" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="每个文件生成一个 txt"/>
                        <ComboBoxItem Content="全部合并成一个 txt"/>
                    </ComboBox>
                </StackPanel>

                <!-- 选项 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                    <CheckBox x:Name="ChkRemoveHeaders" Content="剔除重复页眉页脚" IsChecked="True"
                              FontSize="12" VerticalAlignment="Center"
                              ToolTip="自动去掉每页重复的页眉页脚，以及行尾的「第 N 页 / 共 M 页」"/>
                    <CheckBox x:Name="ChkCollapseBlank" Content="压缩空行" IsChecked="True"
                              FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <CheckBox x:Name="ChkPageSeparator" Content="页之间插入分隔标记" IsChecked="True"
                              FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="扫描件 PDF 没有文字层，无法提取；需要 OCR 才能识别图片里的文字"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始提取"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
