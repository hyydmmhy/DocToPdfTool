<UserControl x:Class="DocToPdfTool.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 搜索区（水平居中） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,20">
            <TextBox x:Name="TxtSearch" Width="320" FontSize="14" Height="34"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>
            <Button x:Name="BtnSearch" Content="🔍 搜索" Padding="16,6" Height="34" Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnSearch_Click"/>
        </StackPanel>

        <!-- 功能按钮网格（整体水平居中，内容多时自动换行/滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="FunctionPanel" Orientation="Horizontal"
                       HorizontalAlignment="Center" MaxWidth="760">
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
