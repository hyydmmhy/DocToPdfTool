<UserControl x:Class="DocToPdfTool.Pages.PdfPageNumberPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="200"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="页数" Width="70"
                                    DisplayMemberBinding="{Binding PageText}"/>
                    <GridViewColumn Header="状态" Width="120"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="72">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="6,2" FontSize="12"
                                        MinWidth="46" HorizontalAlignment="Center"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区（固定高度、顶部对齐） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="124">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 位置 / 格式 / 起始 / 字号 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="位置:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbPosition" SelectedIndex="0" Width="88" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="底部居中"/>
                        <ComboBoxItem Content="底部左侧"/>
                        <ComboBoxItem Content="底部右侧"/>
                        <ComboBoxItem Content="顶部居中"/>
                        <ComboBoxItem Content="顶部左侧"/>
                        <ComboBoxItem Content="顶部右侧"/>
                    </ComboBox>

                    <TextBlock Text="格式:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbFormat" SelectedIndex="0" Width="86" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="第 1 页"/>
                        <ComboBoxItem Content="1 / 20"/>
                        <ComboBoxItem Content="- 1 -"/>
                    </ComboBox>

                    <TextBlock Text="起始:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtStart" Width="44" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="1"/>

                    <TextBlock Text="字号:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtFontSize" Width="42" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="10"/>
                </StackPanel>

                <!-- 边距 / 颜色 / 跳过首页 / 页码范围 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                    <TextBlock Text="边距:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbMargin" SelectedIndex="0" Width="72" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="10 mm"/>
                        <ComboBoxItem Content="15 mm"/>
                        <ComboBoxItem Content="20 mm"/>
                        <ComboBoxItem Content="25 mm"/>
                    </ComboBox>

                    <TextBlock Text="颜色:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbColor" SelectedIndex="0" Width="64" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="黑色"/>
                        <ComboBoxItem Content="灰色"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkSkipFirst" Content="跳过首页" FontSize="12"
                              VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <TextBlock Text="页码范围:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtPageRanges" Width="86" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

                <!-- 提示 -->
                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="页码绘制在原有内容之上；页码范围留空=全部页，支持 1-3,5；跳过首页时首页不占编号"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始加页码"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
