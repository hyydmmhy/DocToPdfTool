<UserControl x:Class="DocToPdfTool.Pages.PdfEncryptPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6"
                    Click="BtnAddFiles_Click"/>
            <TextBlock x:Name="TxtDropHint" Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="页数" Width="70"
                                    DisplayMemberBinding="{Binding PageText}"/>
                    <GridViewColumn Header="状态" Width="90"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="路径" Width="220"
                                    DisplayMemberBinding="{Binding FilePath}"/>
                    <GridViewColumn Header="操作" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="8,2" FontSize="12"
                                        Tag="{Binding}"
                                        Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态提示 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区域（高度固定、顶部对齐，元素常驻占位，保证列表高度与首行位置恒定） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="186">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- 模式切换 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="操作模式:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <RadioButton x:Name="RdoEncrypt" Content="加密" IsChecked="True" Margin="10,0,0,0"
                                 GroupName="Mode" VerticalAlignment="Center"
                                 Checked="Mode_Changed"/>
                    <RadioButton x:Name="RdoDecrypt" Content="移除密码" Margin="18,0,0,0"
                                 GroupName="Mode" VerticalAlignment="Center"
                                 Checked="Mode_Changed"/>
                </StackPanel>

                <!-- 加密设置 -->
                <StackPanel x:Name="PanelEncrypt" Margin="0,6,0,0">

                    <!-- 打开密码 + 确认 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                        <TextBlock Text="打开密码:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                        <Grid Width="150" Margin="6,0,0,0">
                            <PasswordBox x:Name="PwdOpen" Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtOpen" Height="26" Padding="6,0" Visibility="Collapsed"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="WmOpen" Text="6-128位，区分大小写"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="7,0,0,0" Foreground="#BBBBBB" FontSize="11"/>
                        </Grid>
                        <Button x:Name="BtnEyeOpen" Content="👁" Width="26" Height="26" Margin="2,0,0,0"
                                FontSize="12" Padding="0" Cursor="Hand" Background="Transparent"
                                BorderThickness="0" ToolTip="显示 / 隐藏密码"/>

                        <TextBlock Text="确认密码:" VerticalAlignment="Center" Foreground="#888888"
                                   FontSize="12" Margin="10,0,0,0"/>
                        <Grid Width="150" Margin="6,0,0,0">
                            <PasswordBox x:Name="PwdOpenConfirm" Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtOpenConfirm" Height="26" Padding="6,0" Visibility="Collapsed"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="WmOpenConfirm" Text="再次输入密码"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="7,0,0,0" Foreground="#BBBBBB" FontSize="11"/>
                        </Grid>
                        <Button x:Name="BtnEyeOpenConfirm" Content="👁" Width="26" Height="26" Margin="2,0,0,0"
                                FontSize="12" Padding="0" Cursor="Hand" Background="Transparent"
                                BorderThickness="0" ToolTip="显示 / 隐藏密码"/>
                    </StackPanel>

                    <!-- 编辑密码 + 确认 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                        <TextBlock Text="编辑密码:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                        <Grid Width="150" Margin="6,0,0,0">
                            <PasswordBox x:Name="PwdOwner" Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtOwner" Height="26" Padding="6,0" Visibility="Collapsed"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="WmOwner" Text="6-128位，区分大小写"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="7,0,0,0" Foreground="#BBBBBB" FontSize="11"/>
                        </Grid>
                        <Button x:Name="BtnEyeOwner" Content="👁" Width="26" Height="26" Margin="2,0,0,0"
                                FontSize="12" Padding="0" Cursor="Hand" Background="Transparent"
                                BorderThickness="0" ToolTip="显示 / 隐藏密码"/>

                        <TextBlock Text="确认密码:" VerticalAlignment="Center" Foreground="#888888"
                                   FontSize="12" Margin="10,0,0,0"/>
                        <Grid Width="150" Margin="6,0,0,0">
                            <PasswordBox x:Name="PwdOwnerConfirm" Height="26" Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtOwnerConfirm" Height="26" Padding="6,0" Visibility="Collapsed"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="WmOwnerConfirm" Text="再次输入密码"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="7,0,0,0" Foreground="#BBBBBB" FontSize="11"/>
                        </Grid>
                        <Button x:Name="BtnEyeOwnerConfirm" Content="👁" Width="26" Height="26" Margin="2,0,0,0"
                                FontSize="12" Padding="0" Cursor="Hand" Background="Transparent"
                                BorderThickness="0" ToolTip="显示 / 隐藏密码"/>
                    </StackPanel>

                    <!-- 加密算法 + 权限 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="26">
                        <TextBlock Text="加密算法:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                        <ComboBox x:Name="CmbAlgorithm" SelectedIndex="0" Margin="6,0,16,0" Width="150"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="AES-256（推荐）"/>
                            <ComboBoxItem Content="AES-128"/>
                            <ComboBoxItem Content="RC4-128（兼容旧版）"/>
                        </ComboBox>

                        <TextBlock Text="权限:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                        <ComboBox x:Name="CmbPreset" SelectedIndex="1" Margin="6,0,0,0" Width="130"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbPreset_SelectionChanged">
                            <ComboBoxItem Content="全部允许"/>
                            <ComboBoxItem Content="仅查看"/>
                            <ComboBoxItem Content="允许打印"/>
                            <ComboBoxItem Content="自定义"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 自定义权限（始终占位，非自定义时禁用） -->
                    <StackPanel x:Name="PanelCustom" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,6,0,0" Height="26" IsEnabled="False">
                        <CheckBox x:Name="ChkPrint" Content="允许打印" IsChecked="False" Margin="0,0,14,0"
                                  FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkCopy" Content="允许复制" IsChecked="False" Margin="0,0,14,0"
                                  FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkModify" Content="允许修改" IsChecked="False" Margin="0,0,14,0"
                                  FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkAnnotate" Content="允许批注" IsChecked="False" Margin="0,0,14,0"
                                  FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkForm" Content="允许填表" IsChecked="False"
                                  FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 提示（常驻一行，只换文案不换高度） -->
                    <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="#BB8855" FontSize="11" Height="16"
                               TextTrimming="CharacterEllipsis"
                               Text="未填写编辑密码：仅设置打开密码，不限制编辑与权限（使用 RC4-128 加密）"/>
                </StackPanel>

                <!-- 移除密码设置 -->
                <StackPanel x:Name="PanelDecrypt" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,6,0,0" Height="26" Visibility="Collapsed">
                    <TextBlock Text="编辑密码:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <Grid Width="200" Margin="6,0,0,0">
                        <PasswordBox x:Name="PwdDecrypt" Height="26" Padding="6,0"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="TxtDecrypt" Height="26" Padding="6,0" Visibility="Collapsed"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="WmDecrypt" Text="输入编辑密码"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Margin="7,0,0,0" Foreground="#BBBBBB" FontSize="11"/>
                    </Grid>
                    <Button x:Name="BtnEyeDecrypt" Content="👁" Width="26" Height="26" Margin="2,0,0,0"
                            FontSize="12" Padding="0" Cursor="Hand" Background="Transparent"
                            BorderThickness="0" ToolTip="显示 / 隐藏密码"/>
                    <TextBlock Text="未设编辑密码时填打开密码或留空"
                               VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始处理"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度，文本出现/消失不挤压列表） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
