<UserControl x:Class="DocToPdfTool.Pages.PdfSplitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6"
                    Click="BtnAddFiles_Click"/>
            <TextBlock x:Name="TxtDropHint" Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="150"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="路径" Width="240"
                                    DisplayMemberBinding="{Binding FilePath}"/>
                    <GridViewColumn Header="页数" Width="50"
                                    DisplayMemberBinding="{Binding PageCount}"/>
                    <GridViewColumn Header="操作" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="8,2" FontSize="12"
                                        Tag="{Binding}"
                                        Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态提示 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 拆分设置 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,12,0,8">
            <StackPanel HorizontalAlignment="Center">
                <!-- 拆分方式选择 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <RadioButton x:Name="RadioByPages" Content="按页数拆分" IsChecked="True"
                                 GroupName="SplitMode" VerticalAlignment="Center"
                                 Checked="SplitMode_Changed"/>
                    <RadioButton x:Name="RadioByRange" Content="按范围拆分"
                                 GroupName="SplitMode" VerticalAlignment="Center" Margin="16,0,0,0"
                                 Checked="SplitMode_Changed"/>
                </StackPanel>
                <!-- 按页数拆分设置 -->
                <StackPanel x:Name="PanelByPages" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="每" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtPagesPerFile" Width="50" Margin="6,0"
                             Text="1" TextAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="页拆分为一个文件" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                </StackPanel>
                <!-- 按范围拆分设置 -->
                <StackPanel x:Name="PanelByRange" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="页码范围:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <TextBox x:Name="TxtPageRanges" Width="200" Margin="6,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="（逗号分隔，如 1-5,6,7-8）" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 拆分按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
            <Button x:Name="BtnSplit" Content="执 行 拆 分"
                    Padding="24,8" Width="160"
                    Click="BtnSplit_Click"/>
        </StackPanel>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="4" x:Name="TxtConversionStatus"
                   Foreground="#999999" FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>