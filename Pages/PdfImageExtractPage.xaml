<UserControl x:Class="DocToPdfTool.Pages.PdfImageExtractPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAddFiles" Content="添加PDF文件" Padding="16,6" Click="BtnAddFiles_Click"/>
            <TextBlock x:Name="TxtDropHint" Text="或拖拽PDF文件到此处"
                       VerticalAlignment="Center" Foreground="#999999" FontSize="12"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <ListView Grid.Row="1" x:Name="FileListView"
                  AllowDrop="True"
                  Drop="FileListView_Drop"
                  PreviewDragOver="FileListView_PreviewDragOver"
                  SizeChanged="FileListView_SizeChanged"
                  BorderBrush="#E0E0E0" BorderThickness="1"
                  Foreground="#1A1A1A"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666666"/>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="220"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="页数" Width="70"
                                    DisplayMemberBinding="{Binding PageText}"/>
                    <GridViewColumn Header="提取结果" Width="160"
                                    DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="状态" Width="110"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="操作" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="移除" Padding="8,2" FontSize="12"
                                        Tag="{Binding}" Click="BtnRemoveFile_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <TextBlock Text="拖拽PDF文件到此处，或点击上方「添加PDF文件」按钮"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBBBBB" FontSize="14"/>
        </Border>

        <!-- 设置区（固定高度、顶部对齐） -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,6,0,6"
                Height="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <TextBlock Text="输出格式:" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                    <ComboBox x:Name="CmbFormat" SelectedIndex="0" Width="128" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="原始格式"/>
                        <ComboBoxItem Content="统一 PNG"/>
                        <ComboBoxItem Content="统一 JPEG"/>
                    </ComboBox>

                    <TextBlock Text="最小边长:" VerticalAlignment="Center" Foreground="#888888"
                               FontSize="12" Margin="16,0,0,0"/>
                    <TextBox x:Name="TxtMinSize" Width="56" Height="26" Margin="6,0,0,0"
                             VerticalContentAlignment="Center" Text="64"/>
                    <TextBlock Text="像素（更小的图标会被忽略，0=不过滤）"
                               VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="24">
                    <CheckBox x:Name="ChkSkipDuplicates" Content="跳过重复图片（同一张图只导出一次）"
                              FontSize="12" VerticalAlignment="Center" IsChecked="True"/>
                </StackPanel>

                <TextBlock x:Name="TxtHint" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="#8888AA" FontSize="11" Height="16"
                           TextTrimming="CharacterEllipsis"
                           Text="原始格式：JPEG 原样导出（字节不变）；其余编码解码后存为 PNG，画质无损"/>
            </StackPanel>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button x:Name="BtnExecute" Content="开始提取图片"
                    Padding="24,8" Width="160"
                    Click="BtnExecute_Click"/>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
