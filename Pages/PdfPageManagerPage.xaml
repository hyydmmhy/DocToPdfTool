<UserControl x:Class="DocToPdfTool.Pages.PdfPageManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnOpen" Content="打开PDF" Padding="16,6" Click="BtnOpen_Click"/>
            <Button x:Name="BtnReset" Content="重置" Padding="12,4" Margin="8,0,0,0"
                    Click="BtnReset_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtFileInfo" Text="未打开文件"
                       VerticalAlignment="Center" Foreground="#888888" FontSize="12"
                       Margin="12,0,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 页面缩略图 -->
        <ListBox Grid.Row="1" x:Name="PageList"
                 BorderBrush="#E0E0E0" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Extended"
                 Background="White">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                        <Setter TargetName="Bd" Property="Background" Value="#EAF3FB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#BBD9F2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="104">
                        <Border Width="100" Height="130" Background="#FAFAFA"
                                BorderBrush="#E8E8E8" BorderThickness="1" ClipToBounds="True">
                            <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding RotationText}" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="#B07A20"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyOverlay" Background="White"
                IsHitTestVisible="False" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="点击「打开PDF」选择一个文件开始管理页面"
                           Foreground="#BBBBBB" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="支持：旋转、删除、调整顺序、仅导出选中页"
                           Foreground="#CCCCCC" FontSize="12" Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 操作按钮（两行，避免窗口较窄时显示不全） -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="28">
                <Button x:Name="BtnRotateLeft" Content="↺ 左转90°" Padding="10,4"
                        Click="BtnRotateLeft_Click" ToolTip="选中页逆时针旋转 90°"/>
                <Button x:Name="BtnRotateRight" Content="↻ 右转90°" Padding="10,4" Margin="8,0,0,0"
                        Click="BtnRotateRight_Click" ToolTip="选中页顺时针旋转 90°"/>
                <Button x:Name="BtnMoveUp" Content="↑ 上移" Padding="10,4" Margin="18,0,0,0"
                        Click="BtnMoveUp_Click" ToolTip="选中页向前移动一位"/>
                <Button x:Name="BtnMoveDown" Content="↓ 下移" Padding="10,4" Margin="8,0,0,0"
                        Click="BtnMoveDown_Click" ToolTip="选中页向后移动一位"/>
                <Button x:Name="BtnDelete" Content="🗑 删除选中" Padding="10,4" Margin="18,0,0,0"
                        Click="BtnDelete_Click" ToolTip="从结果中移除选中页"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Height="28">
                <Button x:Name="BtnExportSelected" Content="仅导出选中页" Padding="14,4"
                        Click="BtnExportSelected_Click"
                        ToolTip="把当前选中的页按现有顺序导出为一个新 PDF"/>
                <Button x:Name="BtnExportAll" Content="导出全部页" Padding="14,4" Margin="10,0,0,0"
                        Click="BtnExportAll_Click"
                        ToolTip="按当前顺序与旋转导出完整 PDF"/>
            </StackPanel>
        </StackPanel>

        <!-- 状态提示（固定高度） -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus"
                   Foreground="#999999" FontSize="12" Height="18"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text=""/>
    </Grid>
</UserControl>
